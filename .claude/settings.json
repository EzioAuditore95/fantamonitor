{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npx tsc --noEmit)",
      "Bash(node --test:*)",
      "Bash(node --experimental-strip-types:*)",
      "Bash(python -m unittest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(node -v)",
      "Bash(npm -v)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./lib/data/**)",
      "Read(./prototype/data/**)",
      "Bash(git push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npx vercel:*)",
      "Bash(railway:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(psql:*)",
      "Bash(curl:*)"
    ]
  }
}
