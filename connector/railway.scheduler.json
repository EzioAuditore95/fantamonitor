{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "connector/Dockerfile.scheduler",
    "watchPatterns": ["connector/scheduler-server.mjs", "connector/lib/scheduler.mjs", "connector/Dockerfile.scheduler", "connector/railway.scheduler.json"]
  },
  "deploy": {
    "startCommand": "node scheduler-server.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "sleepApplication": false
  }
}
